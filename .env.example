# Tloque — referencia de configuración. En Replit, usa Secrets; no crees un
# archivo .env con valores reales ni lo incluyas en un ZIP.

# Obligatorios para publicar
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:5432/BASE
APP_URL=https://TU-DOMINIO-PUBLICO
ADMIN_EMAIL=TU-CORREO-DE-GOOGLE
SESSION_SECRET=GENERA-UNA-CADENA-ALEATORIA-DE-AL-MENOS-32-CARACTERES
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Pagos. Ambos secretos son obligatorios para que Stripe se habilite.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Nunca acredita Tinta gratis salvo que se active explícitamente.
PAYMENTS_BETA_MODE=false

# Oráculo / Groq (opcionales)
ORACLE_PROVIDER=groq
GROQ_API_KEY=
ORACLE_MODEL=openai/gpt-oss-120b

# Audiolibros (opcionales; requieren worker y almacenamiento)
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
AUDIOBOOK_GENERATION_ENABLED=false
AUDIOBOOK_WORKER_TOKEN=
AUDIOBOOK_STORAGE_DIR=
AUDIOBOOK_SIGNING_URL=

# Ajustes opcionales de PostgreSQL
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
DB_QUERY_TIMEOUT_MS=30000
